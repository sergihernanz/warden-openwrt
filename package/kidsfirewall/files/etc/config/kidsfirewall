	list domain 'facebook.com'
	list domain 'fbcdn.net'

config service 'snapchat'
	option name 'Snapchat'
	list domain 'snapchat.com'
	list domain 'sc-cdn.net'

config service 'roblox'
	option name 'Roblox'
	list domain 'roblox.com'
	list domain 'rbxcdn.com'

config service 'twitch'
