
config global 'global'
	option enabled '1'
	option check_interval '60'
	# Safe DNS: network-wide filtered upstream resolver, independent of
	# global.enabled and of the per-device rules below.
	#   off | cleanbrowsing | opendns | cloudflare | custom
	option safe_dns 'off'
	# only used when safe_dns is 'custom' -- one resolver IP per line
	# list safe_dns_server '1.2.3.4'
	# Force DNS: redirect all br-lan port 53 (TCP+UDP) traffic to this
	# router's own dnsmasq, regardless of what any device is configured to
	# use as its resolver. Closes the bypass a device with a manually-set
	# external DNS server would otherwise have. Does not catch DNS-over-HTTPS.
	option force_dns '0'

# Example device — edit the mac (and add more 'device' sections) via LuCI
# or by hand. Set enabled '0' or delete the block entirely once you've
# added your own.
config device 'example_device'
	option name 'Example Device'
	option mac '00:11:22:33:44:55'
	option enabled '0'

config service 'instagram'
	option name 'Instagram'
	list domain 'instagram.com'
	list domain 'cdninstagram.com'

config service 'tiktok'
	option name 'TikTok'
	list domain 'tiktok.com'
	list domain 'tiktokcdn.com'
	list domain 'tiktokv.com'
	list domain 'musical.ly'

config service 'youtube'
	option name 'YouTube'
	list domain 'youtube.com'
	list domain 'youtu.be'
	list domain 'googlevideo.com'
	list domain 'ytimg.com'

config service 'facebook'
